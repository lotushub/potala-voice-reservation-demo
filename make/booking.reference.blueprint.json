              "id": 6,
              "module": "google-calendar:createAnEvent",
              "version": 5,
              "parameters": {
                "__IMTCONN__": null
              },
              "filter": {
                "name": "Free slot",
                "conditions": [
                  [
                    {
                      "a": "{{3.`__IMTAGGLENGTH__`}}",
                      "o": "number:less",
                      "b": "15"
                    },
                    {
                      "a": "{{1.guests}}",
                      "o": "number:lessorequal",
                      "b": "4"
                    },
                    {
                      "a": "{{1.guests}}",
                      "o": "number:greaterorequal",
                      "b": "1"
                    },
                    {
                      "a": "{{switch(formatDate(parseDate(1.date; \"YYYY-MM-DD\"; \"Europe/Zurich\"); \"E\"; \"Europe/Zurich\"); 6; \"|17:00|17:30|18:00|18:30|19:00|19:30|20:00|20:30|\"; 7; \"|17:00|17:30|18:00|18:30|19:00|19:30|\"; \"|11:30|12:00|12:30|17:00|17:30|18:00|18:30|19:00|19:30|20:00|20:30|\")}}",
                      "o": "text:contain",
                      "b": "|{{1.time}}|"
                    },
                    {
                      "a": "{{parseDate(1.date + 1.time; \"YYYY-MM-DD HH:mm\"; \"Europe/Zurich\")}}",
                      "o": "date:greater",
                      "b": "{{now}}"
                    },
                    {
                      "a": "{{formatDate(parseDate(1.date; \"YYYY-MM-DD\"; \"Europe/Zurich\"); \"E\"; \"Europe/Zurich\")}}",
                      "o": "number:notequal",
                      "b": "1"
                    }
                  ]
                ]
              },
